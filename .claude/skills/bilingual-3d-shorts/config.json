    "output_format": "mp3_44100_128",
    "max_atempo": 1.06,
    "en": {
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "voice_name": "George (premade)",
      "settings": {
        "stability": 0.5,
        "similarity_boost": 0.8,
        "style": 0.15,
        "use_speaker_boost": true,
        "speed": 1.04
      },
      "chars_per_sec": 15.85
    },
    "ta": {
      "voice_id": "JBFqnCBsd6RMkjVDRZzb",
      "voice_name": "George (premade)",
      "settings": {
        "stability": 0.52,
        "similarity_boost": 0.8,
        "style": 0.12,
        "use_speaker_boost": true,
        "speed": 1.02
      },
      "chars_per_sec": 14.94
    },
    "edge": {
      "note": "Microsoft Edge online voices (edge-tts). The *Multilingual* voices return no audio (2026-11-28); audition with voice.py sample --provider edge",
      "en": {
        "voice": "en-US-AndrewNeural",
        "rate": "+0%",
        "pitch": "+0Hz"
      },
      "ta": {
        "voice": "ta-IN-ValluvarNeural",
        "rate": "+0%",
        "pitch": "+0Hz"
      }
