  "image": {
    "provider": "nano-banana-manual",
    "note": "Frames are made by the user in the Gemini app / Google AI Studio (Nano Banana) from keyframes/NANO_BANANA.md. Stills are stored 1.3x (store_width x store_height, lanczos + light unsharp) so 2.5D push-ins up to 1.26x stay sharp.",
    "width": 1080,
    "height": 1920,
    "store_width": 1404,
    "store_height": 2496,
    "sharpen": "unsharp=5:5:0.55:5:5:0"
  },
  "style_presets": {
    "realistic-cgi": "realistic 3D CGI render, Unreal Engine 5 cinematic, stylized-realistic proportions, glossy physically based materials, crisp micro detail, teal and cyan clinical color palette, soft volumetric key light, bright rim light, subtle subsurface scattering, shallow depth of field, cinematic composition, vertical 9:16 frame",
    "clay-stylized": "stylized 3D animation render, smooth polished clay-like shaders, rounded friendly shapes, subsurface scattering, octane render look, vibrant rim light, soft ambient occlusion, clean studio background, shallow depth of field, vertical 9:16 frame",
    "macro-anatomy": "3D medical visualization render, macro cross-section cutaway, semi-translucent glossy tissue, bright interior lighting, high contrast specular highlights, teal background haze, extreme close-up 85mm lens, shallow depth of field, vertical 9:16 frame"
  },
  "default_style": "realistic-cgi",
  "prompt_suffix": "no text, no letters, no watermark, no logo, no caption, no split screen, single frame",
